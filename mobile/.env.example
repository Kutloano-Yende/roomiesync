# RoomieSync Mobile — Environment Variables (example)
#
# Copy this file to `.env` and adjust values locally.
# Never commit a real `.env` file or actual secrets to the repository.
#
# Expo inlines variables prefixed with EXPO_PUBLIC_ at build time, so only
# public, client-safe values belong here. Authentication and third-party
# service configuration (e.g. Firebase, Supabase, Stripe) are NOT included
# yet — those integrations depend on architecture decisions that are
# currently unresolved per the RoomieSync requirements documents.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
