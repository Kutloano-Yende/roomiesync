# RoomieSync Backend — Environment Variables (example)
#
# Copy this file to `.env` and fill in real values locally.
# Never commit a real `.env` file or actual secrets to the repository.
#
# NOTE: Database, authentication, and third-party service configuration
# (e.g. Supabase/PostgreSQL, Firebase Auth, Stripe) are NOT included here
# yet. Those integrations depend on architecture decisions that are
# currently unresolved per the RoomieSync requirements documents and will
# be added once clarified.

APP_NAME=RoomieSync API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
